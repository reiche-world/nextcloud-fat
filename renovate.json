{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":pinGitHubActionDigests"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "(^|/)Dockerfile$"
      ],
      "matchStrings": [
        "ARG\\s+SOURCE_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "docker.io/library/nextcloud",
      "datasourceTemplate": "docker"
    }
  ]
}
